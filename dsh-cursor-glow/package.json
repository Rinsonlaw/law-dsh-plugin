{
  "name": "dsh-cursor-glow",
  "version": "0.1.0",
  "description": "DSH web plugin: breathing rainbow-halo cursor with a colorful particle trail.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
